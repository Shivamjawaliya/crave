NODE_ENV=development
API_PORT=3001

# PostgreSQL
POSTGRES_PASSWORD=postgres_secret_pass
DATABASE_URL=postgresql://food_app:postgres_secret_pass@localhost:5433/food_platform

# Redis & RabbitMQ
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Secrets
JWT_ACCESS_SECRET=food_platform_jwt_access_secret_key_change_in_prod_123456789
JWT_REFRESH_SECRET=food_platform_jwt_refresh_secret_key_change_in_prod_987654321
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Frontends & CORS
WEB_ORIGIN=http://localhost:3000
RESTAURANT_DASHBOARD_ORIGIN=http://localhost:3002
DELIVERY_DASHBOARD_ORIGIN=http://localhost:3003
ADMIN_DASHBOARD_ORIGIN=http://localhost:3004
