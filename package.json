{
  "name": "crave-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Crave — Full-Stack Food Delivery & Restaurant Platform Monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:services": "pnpm --parallel --filter \"./services/*\" dev",
    "dev:gateway": "pnpm --filter api-gateway dev",
    "dev:auth": "pnpm --filter auth-service dev",
    "dev:restaurant-service": "pnpm --filter restaurant-service dev",
    "dev:order-service": "pnpm --filter order-service dev",
    "dev:payment-service": "pnpm --filter payment-service dev",
    "dev:delivery-service": "pnpm --filter delivery-service dev",
    "dev:notification-service": "pnpm --filter notification-service dev",
    "dev:customer": "pnpm --filter customer-web dev",
    "dev:restaurant": "pnpm --filter restaurant-dashboard dev",
    "dev:delivery": "pnpm --filter delivery-dashboard dev",
    "dev:admin": "pnpm --filter admin-dashboard dev",
    "build": "pnpm --recursive run build",
    "build:gateway": "prisma generate --schema=./prisma/schema.prisma && pnpm --filter \"./packages/*\" build && pnpm --filter \"./services/*\" build",
    "start": "node scripts/start-all-production.js",
    "start:production": "node scripts/start-all-production.js",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "prisma:seed": "tsx ./prisma/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "prettier": "^3.5.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.21.0"
}
