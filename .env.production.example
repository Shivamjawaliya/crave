# ==============================================================================
# FOOD PLATFORM — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.production)
# ==============================================================================
# Replace all "yourdomain.com" and placeholder passwords with your real production values.

NODE_ENV=production
GATEWAY_PORT=3001

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# If using AWS RDS, Supabase, Neon, or Railway Managed Postgres:
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
POSTGRES_USER=food_app_admin
POSTGRES_PASSWORD=YOUR_SUPER_STRONG_DATABASE_PASSWORD_HERE
DATABASE_URL=postgresql://food_app_admin:YOUR_SUPER_STRONG_DATABASE_PASSWORD_HERE@postgres:5432/food_platform?schema=public

# ------------------------------------------------------------------------------
# 2. REDIS TELEMETRY & CACHING
# ------------------------------------------------------------------------------
# Used for live driver GPS location streaming (GEOADD) and order deduplication
REDIS_URL=redis://:YOUR_REDIS_STRONG_PASSWORD@redis:6379

# ------------------------------------------------------------------------------
# 3. RABBITMQ MESSAGE BROKER
# ------------------------------------------------------------------------------
# Used for asynchronous events (order.placed, order.accepted, order.ready, delivery dispatch)
RABBITMQ_USER=food_rabbit_admin
RABBITMQ_PASSWORD=YOUR_RABBITMQ_STRONG_PASSWORD_HERE
RABBITMQ_URL=amqp://food_rabbit_admin:YOUR_RABBITMQ_STRONG_PASSWORD_HERE@rabbitmq:5672

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRETS (Generate with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_KEY_1
JWT_REFRESH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_KEY_2
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay Live Production Mode)
# ------------------------------------------------------------------------------
# Get your live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_your_actual_live_key_id
RAZORPAY_KEY_SECRET=your_actual_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

# ------------------------------------------------------------------------------
# 6. INTERNAL MICROSERVICE URLS (Docker network service discovery)
# ------------------------------------------------------------------------------
# In production Docker, services communicate over private docker network by service name
AUTH_SERVICE_URL=http://auth-service:4001
RESTAURANT_SERVICE_URL=http://restaurant-service:4002
ORDER_SERVICE_URL=http://order-service:4003
PAYMENT_SERVICE_URL=http://payment-service:4004
DELIVERY_SERVICE_URL=http://delivery-service:4005
NOTIFICATION_SERVICE_URL=http://notification-service:4006

# ------------------------------------------------------------------------------
# 7. PUBLIC FRONTEND DOMAINS & CORS WHITELIST
# ------------------------------------------------------------------------------
# Replace with your actual purchased domain names (HTTPS required)
WEB_ORIGIN=https://crave.yourdomain.com
RESTAURANT_DASHBOARD_ORIGIN=https://restaurant.yourdomain.com
DELIVERY_DASHBOARD_ORIGIN=https://driver.yourdomain.com
ADMIN_DASHBOARD_ORIGIN=https://admin.yourdomain.com

# ------------------------------------------------------------------------------
# 8. NEXT.JS PUBLIC CLIENT ENV VARIABLES (Baked during Next.js build)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_actual_live_key_id
